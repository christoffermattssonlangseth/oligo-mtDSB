# Ignore data directory
data/
exports/

# Ignore large output files
*.h5ad
*.mtx
#*.csv
*.rds
*.hdf5
*.loom
*.log

# Scratch output of the synthetic test suite
tests/_tmp_region_time/
tests/_tmp_sample_classifier/

# Ignore Jupyter and notebook cache files
.ipynb_checkpoints/

# Ignore Python cache files
__pycache__/
*.pyc
*.pyo

# Ignore system files
.DS_Store
Thumbs.db

# Ignore secret files
.env
*.env 
# Regenerable large tables of the region x time pipeline (>100 MB, GitHub limit);
# recreate with scripts/run_region_time_de.py. Summaries, hit lists, logs and figures are tracked.
results/region_time*/pseudobulk_counts.csv
results/region_time*/de_condition_by_region_age.csv
results/region_time*/de_age_contrast_by_region.csv
results/region_time*/de_interaction_by_region.csv
results/region_time*/de_region_vs_rest.csv
# Per-cell out-of-fold classifier scores (~1M rows); recreate with scripts/run_sample_classifier.py --h5ad
results/sample_classifier/*/cell_scores/
# Superseded classifier outputs (original DA-OL labels, partial runs, first-draft figures); kept locally only
results/sample_classifier/superseded/
# Per-cell metadata + centroids (18 MB); recreate with scripts/export_cell_table.py
results/cell_table/cells.csv.gz
results/cell_table/ol_gene_scores.csv.gz
results/cell_table/cell_gene_scores.csv.gz
results/proximity_model/targets.csv.gz
# Per-cell gene-set scores of the EAE atlas (23 MB); recreate with scripts/export_eae_pseudobulk.py
results/eae_comparison/eae_cell_scores.csv.gz
# Per-cell counts of NSC / OL-lineage / astrocyte genes (5 MB); recreate with scripts/export_cell_counts.py
results/cell_table/nsc_ol_lineage_counts.csv.gz
# Binned myelin transcripts (16 MB); recreate with scripts/export_myelin_transcripts.py (office Mac, raw Xenium)
results/myelin_rna/myelin_tx_bins.csv.gz
# Full DE per cell type (19 MB); analysis/12 recreates it (~5 min) when missing
results/celltype_de/tables/de_by_celltype.csv
